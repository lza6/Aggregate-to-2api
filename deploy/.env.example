# imagefree-api 环境变量配置
# 复制为 .env 或直接 export。所有可用变量及默认值见 api/config.py

# ═══════════════════════════════════════════════════════════════
# 服务监听
# ═══════════════════════════════════════════════════════════════
IF_HOST=127.0.0.1
IF_PORT=8100

# ═══════════════════════════════════════════════════════════════
# 目标站点（一般不用改）
# ═══════════════════════════════════════════════════════════════
IF_BASE_URL=https://imagefree.net
IF_SITEKEY=0x4AAAAAACE-XLGoQUckKKm_

# ═══════════════════════════════════════════════════════════════
# 上游 CF solver（复用 GPT 项目的 cf_solver，端口 8001）
# ═══════════════════════════════════════════════════════════════
IF_CF_SOLVER_URL=http://127.0.0.1:8001

# ═══════════════════════════════════════════════════════════════
# 网络 / 代理
# ═══════════════════════════════════════════════════════════════
# 访问 imagefree 的代理（本机 Clash 示例：127.0.0.1:10808；服务器直连留空）
#IF_PROXY=http://127.0.0.1:10808

# HTTP 连接池参数（IMP-27）
#IF_HTTP_MAX_CONNECTIONS=100
#IF_HTTP_KEEPALIVE=20

# 上游并发控制（IMP-27）：对 imagefree.net 的最大并发请求数
#IF_UPSTREAM_MAX_INFLIGHT=30

# ═══════════════════════════════════════════════════════════════
# 超时 / 轮询
# ═══════════════════════════════════════════════════════════════
IF_TURNSTILE_TIMEOUT=90
# cf_solver 结果轮询间隔（默认 2s；mock/CI 求解极快时调小）
IF_TURNSTILE_POLL_INTERVAL=2.0
IF_GENERATE_TIMEOUT=180
# 图生图上游极慢（实测可卡 20-30 分钟），给足避免中途放弃制造孤儿任务
IF_EDIT_TIMEOUT=3600
# 生成任务硬超时兜底（IMP-04）：杜绝 worker 被永不终态的上游永久挂住
IF_TASK_HARD_TIMEOUT=480
# 图生图排队等待超时：前一个任务未完成时新请求等待的最长时间
IF_EDIT_CONCURRENCY_WAIT=60

# ═══════════════════════════════════════════════════════════════
# 队列 / 并发
# ═══════════════════════════════════════════════════════════════
IF_MAX_QUEUE=2000
# 优先级队列各级独立上限（IMP-01）
#IF_ADMIN_QUEUE_MAX=200
#IF_HIGH_QUEUE_MAX=500
#IF_NORMAL_QUEUE_MAX=1500
IF_WORKERS=10
# Worker 自动伸缩（IMP-03）：默认关闭，开启后 IF_WORKERS 变为初始值
#IF_WORKER_AUTO=1
#IF_WORKERS_MIN=4
#IF_WORKERS_MAX=16
#IF_WORKER_SCALE_UP_THRESHOLD=200
#IF_WORKER_SCALE_DOWN_THRESHOLD=20
#IF_WORKER_IDLE_SECONDS=90
IF_TOKEN_POOL_SIZE=6
IF_TOKEN_TTL=90
IF_SYNC_TIMEOUT=300
IF_GENERATE_MAX_ATTEMPTS=2
IF_TOKEN_WAIT_TIMEOUT=30
# 文生图 transient 错误重试次数（IMP-05）：含首次尝试，超过进入 DLQ
#IF_TXT_RETRY_MAX=3
# 文生图重试指数退避基值（秒）
#IF_TXT_RETRY_BACKOFF_BASE=5

# ═══════════════════════════════════════════════════════════════
# LRU 缓存（IMP-28：首页/画廊/统计降 DB 读压）
# ═══════════════════════════════════════════════════════════════
#IF_LRU_CACHE_SIZE=128
#IF_LRU_CACHE_TTL=5

# ═══════════════════════════════════════════════════════════════
# 图生图并发治理
# ═══════════════════════════════════════════════════════════════
# 上游同出口 IP 并发=1；跨进程文件锁防多实例撞 429
IF_EDIT_MUTEX_ENABLED=1
IF_EDIT_LOCK_MAX_AGE=1500
# 上游并发槽瞬态占用（孤儿任务）自动重试：30 次 × 20s ≈ 10 分钟
IF_EDIT_RETRY_MAX=30
IF_EDIT_RETRY_INTERVAL=20
# 住宅代理池并行（绕过并发=1）：填多 IP 住宅代理文件路径 + 并行数
#IF_EDIT_PROXY_FILE=/app/data/edit_proxies.txt
#IF_EDIT_PROXY_PARALLEL=1
IF_EDIT_PROXY_MAX_INFLIGHT=2
# 每代理 token 池目标水位
IF_EDIT_PROXY_POOL_SIZE=1
# 代理池空闲超时自动回收
IF_EDIT_PROXY_POOL_IDLE_TTL=180

# ═══════════════════════════════════════════════════════════════
# DB 配置
# ═══════════════════════════════════════════════════════════════
IF_DB_FILE=data/imagefree.db
# DB 写连接池大小（IMP-20）：>1 启用多连接模式
#IF_DB_POOL_SIZE=3
#IF_DB_POOL_TIMEOUT=5
# DB 批量写入（IMP-25）：0.2s 窗口合并写操作
#IF_DB_BATCH_ENABLED=1
#IF_DB_BATCH_WINDOW=0.2
# base64 文件缓存目录（IMP-26）
#IF_BASE64_DIR=data/imgs
# base64 文件缓存 TTL（秒），默认 1 天
#IF_BASE64_FILE_TTL=86400

# ═══════════════════════════════════════════════════════════════
# 可观测性 / 治理
# ═══════════════════════════════════════════════════════════════
IF_HEALTHZ_CACHE_TTL=5
IF_TOKEN_PREFETCH_CONCURRENCY=1
# token 预取延迟自适应（IMP-02）
#IF_PREFETCH_AFTER_SOLVE_DELAY=0
#IF_PREFETCH_EMA_ALPHA=0.3
# solver 熔断
IF_SOLVE_CIRCUIT_THRESHOLD=5
IF_SOLVE_CIRCUIT_PROBE_SECONDS=30
IF_SOLVE_STATS_WINDOW_SECONDS=300
IF_DB_RETENTION_DAYS=365
IF_DB_CLEANUP_INTERVAL=21600

# ═══════════════════════════════════════════════════════════════
# 模型 / 画廊 / 统计
# ═══════════════════════════════════════════════════════════════
IF_DEFAULT_MODEL=default
IF_GALLERY_LIMIT=50
IF_STATS_FILE=data/stats.json

# ═══════════════════════════════════════════════════════════════
# 画廊鉴权（P1）
# ═══════════════════════════════════════════════════════════════
# 画廊密码保护。默认空=无密码；非空时 /v1/gallery 需 ?password=xxx 验证
#IF_GALLERY_PASSWORD=my_secret_password

# ═══════════════════════════════════════════════════════════════
# OpenTelemetry 追踪（IMP-08）
# ═══════════════════════════════════════════════════════════════
#IF_OTEL_ENABLED=1
#IF_OTEL_SERVICE_NAME=imagefree-api
#IF_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ═══════════════════════════════════════════════════════════════
# 多提供商网关 / 号池 / 邮箱池 / 代理池
# ═══════════════════════════════════════════════════════════════
# 住宅代理池文件（每行 http://user:pass@host:port）
#IF_PROXY_FILE=/app/data/proxies.txt
# 免费代理池（低成本轮换）
#IF_FREE_PROXY=1
IF_FREE_PROXY_REFRESH_MIN=30
# 代理 429 冷却（逐次递增）
IF_PROXY_COOLDOWN_SECONDS=120
# 代理池每 IP 每日最多使用次数
#IF_PROXY_MAX_USE_PER_DAY=1
# 递增冷却秒数映射（逗号分隔）
#IF_PROXY_USE_COOLDOWN_MAP=0,30,90,300,900
IF_ACCOUNT_DB_FILE=data/account_pool.db
IF_EMAIL_DB_FILE=data/email_registry.db
IF_MINIMAXH3_ACCOUNT_TARGET=500
IF_NANOBANANA_ACCOUNT_TARGET=500
IF_ACCOUNT_AUTO=1
#IF_MOCK_REGISTER=1

# ═══════════════════════════════════════════════════════════════
# 幂等提交（IMP-06）
# ═══════════════════════════════════════════════════════════════
#IF_IDEMPOTENCY_ENABLED=1
#IF_IDEMPOTENCY_TTL=900

# ═══════════════════════════════════════════════════════════════
# 死信队列（IMP-21）
# ═══════════════════════════════════════════════════════════════
#IF_DLQ_ENABLED=1
#IF_DLQ_MAX_RETRIES=3

# ═══════════════════════════════════════════════════════════════
# 健康探测（IMP-22）
# ═══════════════════════════════════════════════════════════════
#IF_HEALTH_CHECK_ENABLED=1
#IF_HEALTH_CHECK_INTERVAL=60

# ═══════════════════════════════════════════════════════════════
# Provider 降级/熔断（IMP-18）
# ═══════════════════════════════════════════════════════════════
#IF_PROVIDER_DEGRADE_THRESHOLD=3
#IF_PROVIDER_RECOVER_INTERVAL=300

# ═══════════════════════════════════════════════════════════════
# 持久化队列（IMP-29）
# ═══════════════════════════════════════════════════════════════
#IF_PERSISTENT_QUEUE_ENABLED=0
#IF_PERSISTENT_QUEUE_DB=data/queue.db