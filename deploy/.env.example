# 听风AI 环境变量模板（120+ 项；config 见 api/config/__init__.py 及 api/config/ 子模块）
# 复制为 .env 并修改：cp .env.example .env
# 变量须以 IF_ 前缀 + 在 api/config/ 有 validation_alias 才会被消费；孤儿变量不生效。

# ── 服务监听 ──
IF_HOST=0.0.0.0
IF_PORT=8100

# ── 上游 ──
IF_BASE_URL=https://imagefree.net
IF_SITEKEY=0x4AAAAAACE-XLGoQUckKKm_

# ── CF 求解器 ──
IF_CF_SOLVER_URL=http://127.0.0.1:8001
# P1-6 / P1-O6 多节点联邦：逗号分隔多 URL，solver_guard 自动加权最少在途调度 + 熔断 failover
# 单机多副本：把 docker-compose.yml 的 cfsolver 服务复制为 cfsolver2/cfsolver3，再填：
#   IF_CF_SOLVER_URLS=http://cfsolver:8001,http://cfsolver2:8001,http://cfsolver3:8001
# Swarm：把 cfsolver 服务的 deploy.replicas: 3 取消注释（需 swarm 模式）。
# 多机：把每个节点 URL 填入（IP 或域名），如：
#   IF_CF_SOLVER_URLS=http://10.0.0.1:8001,http://10.0.0.2:8001,http://10.0.0.3:8001
IF_CF_SOLVER_URLS=http://127.0.0.1:8001
# 节点权重（JSON 或 url=N 格式）；如 {"http://cfsolver:8001": 2}
IF_SOLVER_NODE_WEIGHTS=
# 空闲超时秒：>0 时空闲节点降级为备选（按需停池）；0=关闭（默认）
IF_SOLVER_IDLE_TIMEOUT_SECONDS=0
IF_TURNSTILE_TIMEOUT=90
IF_TURNSTILE_POLL_INTERVAL=2
IF_TOKEN_POOL_SIZE=6
IF_TOKEN_TTL=120
IF_TOKEN_WAIT_TIMEOUT=60

# ── Worker / 队列 ──
IF_WORKERS=10
IF_WORKERS_MIN=4
IF_WORKERS_MAX=16
IF_WORKER_SCALE_UP_THRESHOLD=50
IF_WORKER_SCALE_DOWN_THRESHOLD=10
IF_WORKER_IDLE_SECONDS=60
# v8.0 P1-5: 缩容防抖动秒数
IF_WORKER_SCALE_DOWN_HOLD=30
# 旧版单维扩缩容兼容开关（1=旧逻辑，0=多维评分）
IF_WORKER_SCALER_LEGACY=0
IF_MAX_QUEUE=2000
IF_ADMIN_QUEUE_MAX=200
IF_HIGH_QUEUE_MAX=500
IF_NORMAL_QUEUE_MAX=1500
IF_WORKER_BATCH_ENABLED=0
IF_WORKER_BATCH_SIZE=5
IF_PERSISTENT_QUEUE_ENABLED=0

# ── 生成超时 ──
IF_GENERATE_TIMEOUT=300
IF_GENERATE_POLL_INTERVAL=2
IF_SYNC_TIMEOUT=120
IF_TXT_RETRY_MAX=3
IF_TXT_RETRY_BACKOFF_BASE=1.0

# ── 图生图编辑 ──
IF_EDIT_TIMEOUT=600
IF_EDIT_RETRY_MAX=3
IF_EDIT_RETRY_INTERVAL=30
IF_EDIT_LOCK_MAX_AGE=600
IF_EDIT_MUTEX_ENABLED=1
IF_EDIT_PROXY_PARALLEL=1
IF_EDIT_PROXY_MAX_INFLIGHT=3
IF_EDIT_PROXY_FILE=

# ── 代理池 ──
IF_PROXY=
IF_PROXY_FILE=
IF_FREE_PROXY=0
IF_FREE_PROXY_REFRESH_MIN=30
IF_PROXY_COOLDOWN_SECONDS=120
IF_PROXY_MAX_USE_PER_DAY=1
IF_PROXY_USE_COOLDOWN_MAP=0,30,90,300,900
IF_PROXY_STICKY_WINDOW=300

# ── 号池 ──
IF_ACCOUNT_AUTO=0
IF_MOCK_REGISTER=0
IF_ACCOUNT_DB_FILE=data/account_pool.db
IF_EMAIL_DB_FILE=data/email_registry.db
IF_NANOBANANA_ACCOUNT_TARGET=500
# AI 兜底邮件验证码/链接提取（默认 0=关闭；1=正则未命中时降级 LLM 通道）
IF_MAIL_AI_EXTRACT=0

# ── AI 聊天（v4.4 tryingopen.com 匿名网关）──
IF_TRYINGOPEN_ENABLED=1
IF_TRYINGOPEN_MAX_ATTEMPTS=3
IF_TRYINGOPEN_SYNC_MINUTES=30
IF_TRYINGOPEN_HOURLY_PER_IP=20

# ── 数据库 ──
IF_DB_BATCH_ENABLED=1
IF_DB_BATCH_WINDOW=0.2
IF_DB_POOL_SIZE=3
IF_DB_FILE=data/imagefree.db
IF_DB_RETENTION_DAYS=365
IF_DB_CLEANUP_INTERVAL=21600

# ── 画廊 ──
IF_GALLERY_LIMIT=50
IF_GALLERY_PASSWORD=
# P1-1 画廊签名 URL（推荐）：HMAC 签名 + TTL 过期，替代静态密码防盗链/防爬取。
# 签发经管理 Key 鉴权的 /v1/gallery/sign；访问 /v1/gallery 时把 <exp>:<sig> 作为 password 传入。
# 配了签名密钥后，静态密码不再作为降级回退（防降级攻击）；两者皆空=画廊开放。
IF_GALLERY_SIGNING_SECRET=
IF_GALLERY_SIGNING_TTL=600

# ── 缓存 ──
IF_LRU_CACHE_SIZE=500
IF_LRU_CACHE_TTL=120

# ── 熔断 / 可观测性 ──
IF_HEALTH_CHECK_ENABLED=1
IF_HEALTH_CHECK_INTERVAL=60
IF_PROVIDER_DEGRADE_THRESHOLD=3
IF_PROVIDER_RECOVER_INTERVAL=300
IF_ALERT_CHECK_INTERVAL=60
IF_SOLVE_CIRCUIT_THRESHOLD=5
IF_SOLVE_CIRCUIT_PROBE_SECONDS=30
IF_SLOW_LOG_ENABLED=1
IF_SLOW_REQUEST_MS=5000
IF_SLOW_LOG_SIZE=100

# ── 动态 IP 风控（ISSUE-02：SQLite 封禁表 + 管理面动态封/解）──
# 每 IP 每分钟允许的生成提交次数（0 = 关闭基础限流）
IF_REQUESTS_PER_MINUTE=10
# 白名单 IP（逗号分隔）：绕过封禁与限速（运维/监控探针）
IF_IP_WHITELIST=
# 频繁超限自动入黑名单（窗口内超限达到阈值自动封禁）
IF_AUTO_BLOCK_ENABLED=1
IF_AUTO_BLOCK_THRESHOLD=3
IF_AUTO_BLOCK_WINDOW_SECONDS=300
IF_AUTO_BLOCK_TTL_SECONDS=3600
# v7.7.13: 恶意 IP 永久封禁（防脚本 30分钟解封后继续刷资源）
IF_AUTO_BLOCK_PERMANENT=1
# 管理面安全端点鉴权（逗号分隔多 Key；空 = 开放模式）
IF_API_KEYS=

# ── 死信队列 / 幂等 ──
IF_DLQ_ENABLED=1
IF_DLQ_REQUEUE=0
IF_IDEMPOTENCY_ENABLED=1
IF_IDEMPOTENCY_TTL=86400

# ── 磁盘日志 ──
IF_LOG_DIR=data/logs
IF_LOG_RETENTION_DAYS=7

# ── 图片/文件 ──
IF_BASE64_DIR=data/imgs
IF_BASE64_FILE_TTL=3600
IF_IMG_MAX_GB=5

# ── OpenTelemetry ──
IF_OTEL_ENABLED=0
IF_OTEL_SERVICE_NAME=imagefree-api
IF_OTEL_EXPORTER_OTLP_ENDPOINT=
IF_OTEL_CONSOLE_EXPORTER=0
# P3-2 tail-based 采样：正常请求采样率（0.1=10%）；错误请求 100% 采样
IF_OTEL_SAMPLE_RATE=0.1
IF_OTEL_ERROR_SAMPLE_RATE=1.0

# ── 已废弃变量（config 不消费，保留注释说明历史）──
# IF_MINIMAXH3_ACCOUNT_TARGET：v6.8.0 minimaxh3/kookeey 已全量移除，改用 IF_NANOBANANA_ACCOUNT_TARGET
# IF_MAX_IMAGE_BYTES / IF_MAX_PROMPT_LEN / IF_ASPECT_RATIOS：常量硬编码（MAX_IMAGE_BYTES=4MB / MAX_PROMPT_LEN=2000 / ASPECT_RATIOS dict），非 settings 字段，填了不生效
# IF_USER_AGENT：user_agent 是 settings 字段但未挂 validation_alias，env 不映射；改 UA 需改 api/config/http.py
# IF_KOOKEEY_USER_ID/SEC_USER/SEC_PASS：kookeey 住宅代理已下线（tests/test_registerer.py 注释"kookeey 已移除"）

# ── P1-O5 可选 profile 凭证（docker compose --profile <name> up -d 时消费）──
# Litestream（--profile backup）：异地秒级 SQLite WAL 复制，配置见 deploy/litestream.yml
# 凭证填这里后 docker compose --profile backup up -d 自动透传到 litestream 容器
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
LITESTREAM_S3_BUCKET=imagefree-backups
LITESTREAM_S3_PATH=imagefree
LITESTREAM_S3_REGION=auto
# Grafana（--profile obs）：管理员登录凭证，首次登录用，建议生产改强密码
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Mock 上游（E2E/CI 用） ──
IF_MOCK_UPSTREAM=0
# ── 补充配置（config.py 存在但模板缺）──
IF_DB_POOL_TIMEOUT=
IF_DEFAULT_MODEL=
IF_DLQ_MAX_RETRIES=
IF_DLQ_RETENTION_DAYS=
IF_EDIT_CONCURRENCY_WAIT=
IF_EDIT_PROXY_POOL_IDLE_TTL=
IF_EDIT_PROXY_POOL_SIZE=
IF_GENERATE_MAX_ATTEMPTS=
IF_HEALTHZ_CACHE_TTL=
IF_HTTP_KEEPALIVE=
IF_HTTP_MAX_CONNECTIONS=
IF_PERSISTENT_QUEUE_DB=
IF_PREFETCH_AFTER_SOLVE_DELAY=
IF_PREFETCH_EMA_ALPHA=
IF_SOLVE_STATS_WINDOW_SECONDS=
IF_STATS_FILE=
IF_TASK_HARD_TIMEOUT=
IF_TOKEN_PREFETCH_CONCURRENCY=
# 上游并发上限：留空=按服务器规格自适应（system_spec）；填数字则强制
IF_UPSTREAM_MAX_INFLIGHT=
IF_WORKER_AUTO=
# 请求体总量上限（字节，防恶意大 base64 正文占满内存）
IF_MAX_REQUEST_BODY=8388608
# 求解器单节点速率限流冷却（秒）
IF_SOLVER_RATE_LIMIT_COOLDOWN_SECONDS=60
# P2-3 告警 webhook 外发（企业微信/钉钉/Slack 通用 JSON POST；空 = 不外发）
IF_ALERT_WEBHOOK_URL=
# 存储驱动：sqlite（默认单机）| redis（集群）
IF_STORAGE_BACKEND=sqlite
IF_REDIS_ENABLED=0
IF_REDIS_URL=redis://localhost:6379/0
# ── v8.1 P1-A agent 化能力跃迁开关（全部缺省开启，回滚置 0 即回退原行为）──
# P1-A1 skills 四件套体系（api/skills/<scene>/SKILL.md + frontmatter 索引）
IF_AGENT_SKILLS_ENABLED=1
# P1-A2 意图分类→Provider/Skill 路由层（规则正则兜底 + LLM 仅处理模糊意图）
IF_AGENT_INTENT_CLASSIFIER=1
# P1-A3 L0-L3 记忆分层 + 异步巩固管道（复用 imagefree.db 加 mem_* 表）
IF_MEMORY_CONSOLIDATION_ENABLED=1
# 记忆巩固后台 worker 周期（秒，默认 300s）
IF_MEMORY_CONSOLIDATION_INTERVAL=300
# P1-A4 provider 风险档案 Tier + PreToolUse 硬门禁（paid Tier 默认拦截真实付费）
IF_PROVIDER_RISK_TIER=1
# P1-A7 独立终检 Agent（交付前 LLM 审查，用 tryingopen 免费上游）
IF_CRITIC_AGENT_ENABLED=1
# 成本 / 预算（M6-F3）：每积分折算美元；0=不估算图片成本
IF_USD_PER_CREDIT=0
IF_COST_BUDGET_USD=0
# CORS 来源白名单（逗号分隔；默认 * 全放行向后兼容）
# 生产建议收紧为固定域名，如：IF_CORS_ORIGINS=https://imagefree.tingfengai.art
# 多域名逗号分隔：IF_CORS_ORIGINS=https://a.com,https://b.com
# 本地开发用 *；生产用固定域名可防跨站滥用
IF_CORS_ORIGINS=*
# P3-3 生产安全响应头注入开关（默认开启；关闭=最小回滚）
IF_SECURITY_HEADERS_ENABLED=1
# P3-3 宽松 CSP 响应头开关（默认关闭，避免误杀管理面板 inline script / 画廊 CDN 图片）
# 生产开启前需把画廊图源域名加入 img-src（见 api/main.py SecurityHeadersMiddleware._CSP 常量）
IF_CSP_ENABLED=0
# 受信代理：逗号分隔 IP。仅当 socket 对端命中时才解析 X-Forwarded-For。
# 生产反代场景追加反代对端 IP（如 Docker 网关 172.28.0.1）；uvicorn --proxy-headers
# 已重写 request.client，此变量为应用层 get_client_ip 的双保险（精确 IP 匹配，不支持 CIDR）。
IF_TRUSTED_PROXIES=127.0.0.1,::1
# 管理面安全端点鉴权（独立 Key；空 = 继承 IF_API_KEYS；两者皆空默认拒绝管理操作）
# 生产强烈建议配置独立管理 Key（不继承业务 Key），防权限提权：业务 Key 持有者将无法执行封禁/DLQ/审计
IF_ADMIN_KEYS=
# 显式开放模式：仅当配置为空且设为 1 时放行管理端（本地运维/内网）
IF_ADMIN_KEY_OPEN=0
# 管理员申诉联系方式（被封禁用户可据此联系解封；空=不展示）
IF_ADMIN_CONTACT=
# 聊天端点每分钟限流（v4.4；0 = 不限）
IF_CHAT_RATE_LIMIT=60
# TensorFeed AI 生态（v6.7.0）
IF_TENSORFEED_BASE=https://tensorfeed.ai
IF_TENSORFEED_CACHE_TTL=900
# 注册退避（秒）：CF/邮箱/IP/瞬态基值/瞬态上限
IF_REG_BACKOFF_CF=30
IF_REG_BACKOFF_EMAIL=60
IF_REG_BACKOFF_IP=120
IF_REG_BACKOFF_TRANSIENT_BASE=2
IF_REG_BACKOFF_TRANSIENT_MAX=30
# Cloudflare trace 出口探测器（v6.7.x；默认关闭，零网络开销）
IF_PROXY_TRACE_ENABLED=0
IF_PROXY_TRACE_TTL=3600
IF_PROXY_TRACE_MAX_PER_ROUND=50
IF_PROXY_TRACE_CONCURRENCY=8
# 图生图租约（ISSUE：编辑互斥/租约模式）
IF_EDIT_LEASE_ENABLED=0
IF_EDIT_LEASE_TTL=30
# L1 秒级令牌桶（None = 默认取 IF_REQUESTS_PER_MINUTE；<=0 关闭 L1）
IF_RATE_TOKEN_CAPACITY=
IF_RATE_TOKEN_REFILL_PER_SEC=0
# fal.ai minimax-H3 视频提供商（Playwright 浏览器即服务）
IF_FALAI_ENABLED=1
IF_FALAI_HCAPTCHA_SITEKEY=
IF_FALAI_HCAPTCHA_MODE=passive
IF_FALAI_BROWSER_HEADFUL=1
IF_FALAI_BROWSER_POOL_SIZE=2
IF_FALAI_VERIFY_TIMEOUT=90
IF_FALAI_POLL_INTERVAL=2
IF_FALAI_POLL_TIMEOUT=120
# P3-1 路由决策持久化（独立轻量 sqlite；空 = 关闭，默认）
# 生产建议开启（data/routing.db）：重启后保留路由历史 + 冷启动 warm EWMA；本地开发可留空
IF_ROUTING_DB=
# P0-3 token 池双水位 + 批量并发填充（吞吐工程化，默认关闭=旧逻辑向后兼容）
# direct 池无排队时维持的目标水位（默认1=维持1个；生产建议5保持预热提升零延迟命中率）
IF_TOKEN_TARGET_WATERMARK=
# 紧急水位：total 低于此值时触发批量并发填充（默认0=关闭批量；生产建议2）
IF_TOKEN_URGENT_WATERMARK=
# 批量并发填充数：urgent 时一次并发 N 个 solve（默认1=单次；生产建议4，需 cf_solver 多槽+IF_TOKEN_PREFETCH_CONCURRENCY>=N）
IF_TOKEN_BATCH_FILL_SIZE=
