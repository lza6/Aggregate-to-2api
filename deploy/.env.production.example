# 听风AI 生产环境收紧模板（v7.7）
# ─────────────────────────────────────────────────────────────
# 用途：生产部署时以此文件为基线替换 .env.example 中的宽松默认值。
# 原则：默认拒绝 + 最小暴露面 + 泄露可回滚。
# 启用步骤：
#   1. cp deploy/.env.production.example deploy/.env
#   2. 按下方注释逐项填入真实值（<MUST-FILL> 标记项必填）
#   3. cd deploy && docker compose up -d api   （热更新，零宕机）
#   ⚠ v7.7 起 compose api 服务已配 env_file: .env —— 本文件全部变量会真正进容器
#     （此前 environment 白名单仅透传 2 项，其余 15 项收紧措施静默失效）。
# 回滚：把对应项改回宽松值（每项下方标了回滚值），再次 up -d 即生效。
# 验证：docker compose exec api env | grep IF_ 确认变量已注入；
#       再按各项注释中的验证 curl 逐项确认（如 CORS 预检、401/403 行为）。
# ─────────────────────────────────────────────────────────────

# ══ 1. CORS 收紧（P1-2）══════════════════════════════════════
# 宽松值（回滚用）：IF_CORS_ORIGINS=*
# 生产只放行自家前端域名。管理面板/落地页与 API 同域时，浏览器同源请求
# 不受 CORS 约束；此白名单只影响第三方站点的跨域 XHR。
# 注意：Swagger /docs 的"Try it out"来自同源，不受影响。
IF_CORS_ORIGINS=https://imagefree.tingfengai.art

# ══ 2. 管理面独立 Key（P1-2）═════════════════════════════════
# 宽松值（回滚用）：IF_ADMIN_KEYS= （空 = 继承 IF_API_KEYS）
# <MUST-FILL> 独立管理 Key（≥32 位随机串，勿与业务 Key 重叠）：
#   生成：python -c "import secrets; print('sk-tfai-admin-' + secrets.token_urlsafe(32))"
# 效果：业务 Key 持有者无法执行封禁/DLQ 重放/日志审计等管理操作（防提权）。
IF_ADMIN_KEYS=sk-tfai-admin-<MUST-FILL>

# 业务 API Key（<MUST-FILL>，与 IF_ADMIN_KEYS 分开轮换）
IF_API_KEYS=sk-tfai-<MUST-FILL>

# 显式开放模式（管理端全放开）——生产必须 0！
# 回滚警告：1 = 无 Key 即可调用管理端点（含 /v1/logs、封禁操作），仅限本机调试。
IF_ADMIN_KEY_OPEN=0

# ══ 3. CSP 开启（P1-2，可选渐进）═════════════════════════════
# 宽松值（回滚用）：IF_CSP_ENABLED=0
# 前置条件：核对画廊/管理面板引用的所有外部图源/字体域名都已列入
#   api/main.py SecurityHeadersMiddleware._CSP 的 img-src/style-src 允许表；
#   若有 inline <script> 依赖，先改 nonce 化再开。
# 灰度建议：先开 1 天观察 /v1/logs 是否出现 CSP 违规告警（浏览器 console 上报），
#   再决定是否长期开启。
IF_CSP_ENABLED=0

# ══ 4. 限流与防滥用 ══════════════════════════════════════════
# 每 IP 每分钟生成请求上限（宽松值 30；生产建议 10-20 防脚本薅）
IF_REQUESTS_PER_MINUTE=20
# L1 秒级令牌桶：容量=突发放行数，refill=每秒回填
IF_RATE_TOKEN_CAPACITY=10
IF_RATE_TOKEN_REFILL_PER_SEC=0.5
# 频控超限自动封禁：300s 窗口内超限 5 次 → 封 1800s
IF_AUTO_BLOCK_ENABLED=1
IF_AUTO_BLOCK_THRESHOLD=5
IF_AUTO_BLOCK_WINDOW_SECONDS=300
IF_AUTO_BLOCK_TTL_SECONDS=1800
# 聊天端点每分钟限流
IF_CHAT_RATE_LIMIT=30

# ══ 5. 可观测性 ══════════════════════════════════════════════
# OTel 分布式追踪（默认关闭；开启需 OTLP collector）
IF_OTEL_ENABLED=0
# P3-2 tail-based 采样：错误请求 100% + 正常 10%
IF_OTEL_SAMPLE_RATE=0.1
IF_OTEL_ERROR_SAMPLE_RATE=1.0

# ══ 6. 数据安全（P2-1）═══════════════════════════════════════
# 备份由宿主机 crontab 每日 03:00 全量热备（见 compose 顶部注释）：
#   0 3 * * * cd /home/ubuntu/imagefree-api && python scripts/backup_db.py --db data/imagefree.db --out-dir data/backups
# 备份目录持久化卷已挂载 ./data/backups:/app/data/backups
# 异地副本（强烈建议）：每日 rsync/R2 上传 data/backups/

# ══ 7. 反向代理层建议（nginx/CF 侧，不属 env）═════════════════
# - 启用 Cloudflare 免费层 CDN + WAF 管理规则（挡脚本扫）
# - X-Forwarded-For 只信任 CF/本机（IF_TRUSTED_PROXIES 保持 127.0.0.1,::1 + CF IP 段）
# - 静态资源（/admin /assets）走 CF 缓存，减轻源站
