# ===== 第一阶段：系统依赖 + 浏览器引擎 =====
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    libgtk-3-0 libx11-xcb1 libdbus-glib-1-2 libxt6 libasound2 \
    libxcomposite1 libxdamage1 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
    libnss3 libnspr4 libxss1 libxshmfence1 \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY cf_solver/requirements.txt ./
RUN pip install --no-cache-dir --user -r requirements.txt

# 预下载 camoufox 浏览器引擎（构建期失败会在此报错，见下方启动前检查）
RUN python -m camoufox fetch

# ===== 第二阶段：运行镜像 =====
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/root/.local/bin:$PATH

WORKDIR /app

# 复制系统依赖（apt 安装的 GTK/X11 库，camoufox 需要）
COPY --from=builder /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu

# 复制 Python 依赖
COPY --from=builder /root/.local /root/.local

# 复制 camoufox 浏览器引擎
COPY --from=builder /root/.cache /root/.cache

# 复制应用源码
COPY cf_solver ./

# 启动前检查 camoufox 浏览器引擎就位；缺失时报错而非静默降级
RUN test -d /root/.cache/camoufox || (echo "[error] camoufox 引擎缺失（构建期 fetch 未成功）。请检查网络后重建镜像。" && exit 1)

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import socket; socket.create_connection(('127.0.0.1',8001),timeout=2).close()"

CMD ["python", "boterdrop_wrapper.py"]