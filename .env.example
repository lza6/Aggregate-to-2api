# 听风AI 环境变量模板 — 权威入口
#
# ⚠️ v20.3.1（终局审计 P1）：本文件为「快速上手」精简模板。
#    完整权威模板（380+ 项，覆盖全部 IF_* 配置）见：deploy/.env.example
#    （生产容器实际使用 deploy/.env，来自 deploy/.env.example 模板）
#
# 快速上手：复制本文件为 .env 可跑最小配置；如需全部能力（号池/向量/邮件池/
# MCP/PPT/视频/安全风控/告警/Grafana 等）请改用 deploy/.env.example：
#     cp deploy/.env.example .env
#
# 变量须以 IF_ 前缀 + 在 api/config/ 有 validation_alias 才会被消费；孤儿变量不生效。

# ── 服务监听 ──
IF_HOST=0.0.0.0
IF_PORT=8100

# ── 上游 ──
IF_BASE_URL=https://imagefree.net
IF_SITEKEY=0x4AAAAAACE-XLGoQUckKKm_
IF_MOCK_UPSTREAM=0

# ── 鉴权（公益定位：默认开放，写操作无 Key 也可调；配置后启用）──
IF_API_KEYS=
IF_ADMIN_KEYS=
IF_ADMIN_KEY_OPEN=0

# ── Worker / 队列 ──
IF_WORKERS=4
IF_WORKERS_MIN=4
IF_WORKERS_MAX=16
IF_MAX_QUEUE=2000

# ── 生成 ──
IF_GENERATE_TIMEOUT=300
IF_SYNC_TIMEOUT=120
IF_GALLERY_PASSWORD=
IF_GALLERY_SIGNING_SECRET=
IF_PPT_GENERATE=1
IF_VIDEO_ENABLED=0

# ── 代理池（高并发关键）──
IF_FREE_PROXY=1
IF_FREE_PROXY_REFRESH_MIN=10
IF_PROXY_COOLDOWN_SECONDS=120
IF_PROXY_MAX_USE_PER_DAY=3

# ── CORS ──
IF_CORS_ORIGINS=*

# ── 完整权威模板 ──
# 见 deploy/.env.example（含号池/邮箱池/向量/MCP/Agent DAG/告警/Grafana/安全风控全部变量）
