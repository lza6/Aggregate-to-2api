{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "image-quality-check input schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "asset_url": {
      "type": "string",
      "format": "uri"
    },
    "expected_aspect_ratio": {
      "type": "string",
      "pattern": "^\\d+:\\d+$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "watermark_scan": {
      "type": "boolean"
    },
    "vision_check": {
      "type": "boolean"
    },
    "if_mock_upstream": {
      "type": "boolean"
    }
  },
  "required": [
    "asset_url",
    "expected_aspect_ratio"
  ]
}
