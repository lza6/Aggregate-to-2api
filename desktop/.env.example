# 听风AI 桌面版（Tauri 2.x sidecar）说明
#
# 启动顺序（Tauri 启动时自动执行，无需手动）：
#   1) 后端：python -m uvicorn api.main:app --host 127.0.0.1 --port 8100
#   2) 求解器：python deploy/cf_solver/boterdrop_wrapper.py（或 mock，开发用）
#   3) 健康探测 http://127.0.0.1:8100/v1/healthz 就绪后显示主窗口
#
# 打包为单文件 exe：
#   pip install pyinstaller
#   pyinstaller --onefile --name uvicorn api/main.py  → 产出 backend/uvicorn.exe
#   设 IF_DESKTOP_USE_PYINSTALLER=1 时 sidecar 走该 exe（免用户装 Python）

# ── 后端运行模式 ─────────────────────────────────────────────
# 1 = 用 PyInstaller 打包的 sidecar（无需用户装 Python）；0 = 直接用系统 python
IF_DESKTOP_USE_PYINSTALLER=0

# 1 = 后端以 IF_MOCK_UPSTREAM=1 启动（测试台/演示，零真实上游）
IF_DESKTOP_MOCK_UPSTREAM=1

# ── 端口（与 tauri.conf.json / frontend proxy 保持一致）──────
IF_DESKTOP_API_PORT=8100
IF_DESKTOP_SOLVER_PORT=8001