{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "听风AI Desktop",
  "version": "10.0.0",
  "identifier": "com.tingfeng.ai.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "听风AI · 智能体工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0f1420",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' http://127.0.0.1:8100 http://localhost:8100; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"],
    "resources": ["backend/uvicorn.exe"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
